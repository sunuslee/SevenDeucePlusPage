72plus.pro {
    root * /srv/sevendeuceplus-site/current
    encode zstd gzip
    file_server
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
}
www.72plus.pro {
    redir https://72plus.pro{uri} permanent
}
